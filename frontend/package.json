{
  "name": "actweave-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:check": "node ./scripts/bundle-check.mjs",
    "e2e:workflow": "playwright test e2e/workflow.spec.ts --reporter=line",
    "e2e:workflow:update": "playwright test e2e/workflow.spec.ts --update-snapshots --reporter=line",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts --reporter=line"
  },
  "dependencies": {
    "@codemirror/language": "6.11.3",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@element-plus/icons-vue": "2.3.2",
    "@fortawesome/fontawesome-free": "6.5.1",
    "@vue-flow/core": "1.48.2",
    "axios": "1.18.0",
    "dompurify": "^3.2.4",
    "element-plus": "2.14.2",
    "json5": "^2.2.3",
    "markdown-it": "^14.1.0",
    "pinia": "3.0.4",
    "vue": "3.5.38",
    "vue-i18n": "11.4.8",
    "vue-router": "5.1.0",
    "vxe-table": "4.19.20",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.55.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.6.2",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.5",
    "vitest": "4.1.9",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.3.5"
  }
}
