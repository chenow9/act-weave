          <path class="a2ui-chart-hit" d="M71.8,189.3 A88,88 0 0 1 41.2,55.1 L72.5,80.1 A48,48 0 0 0 89.2,153.2 Z"></path>
          <path class="a2ui-chart-hit" d="M41.2,55.1 A88,88 0 0 1 110,22 L110,62 A48,48 0 0 0 72.5,80.1 Z"></path>
        </svg>
        <!--v-if-->
