        <li><span class="a2ui-chart-swatch" style="background: rgb(37, 99, 235);" aria-hidden="true"></span><span>审计轨迹</span><strong>64 GB</strong><em>28.6%</em></li>
        <li><span class="a2ui-chart-swatch" style="background: rgb(217, 119, 6);" aria-hidden="true"></span><span>附件</span><strong>32 GB</strong><em>14.3%</em></li>
        <li><span class="a2ui-chart-swatch" style="background: rgb(124, 58, 237);" aria-hidden="true"></span><span>冷备</span><strong>0 GB</strong><em>0.0%</em></li>
      </ul>
    </figure>
  </div>
</section>"
`;

