# Copy to a private .env (never commit). No defaults for secrets.

# AAP data plane base URL (no token query parameters).
AAP_BASE_URL=https://actweave.example.com/api/agent-access/v1

# Bound Workspace / Agent for the demo integration.
AAP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
AAP_AGENT_ID=00000000-0000-4000-8000-000000000002

# OAuth client credentials — server-side only (BFF or mint service).
# Never ship these to the browser bundle.
AAP_CLIENT_ID=client_demo
AAP_CLIENT_SECRET=

# Optional: restrict client_credentials / exchange scopes.
AAP_SCOPE=agent:read conversation:create conversation:read run:create run:read run:cancel event:read interaction:decide

# BFF listen address (local demo only).
BFF_LISTEN_HOST=127.0.0.1
BFF_LISTEN_PORT=8787

# Direct-mode mint service listen address (local demo only).
MINT_LISTEN_HOST=127.0.0.1
MINT_LISTEN_PORT=8788

# Subject token issuer settings used when minting demo JWT assertions
# for Token Exchange (server-side). Real deployments use the business IdP.
SUBJECT_TOKEN_ISSUER=https://business.example.com/
SUBJECT_TOKEN_AUDIENCE=actweave-agent-access-subject
