exports[`charts > draws chart-donut as an svg tagged donut 1`] = `
"<div class="a2ui-stack">
    <figure class="a2ui-chart" data-a2ui-chart="donut">
      <div class="a2ui-chart-head">
        <h3 class="a2ui-title">存储占用</h3>
        <span class="a2ui-chart-badge">环图 · GB</span>
      </div>
      <div class="a2ui-chart-body" role="img" aria-label="存储占用">
        <svg class="a2ui-chart-svg a2ui-chart-svg-pie" viewBox="0 0 280 220" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg"><path d="M110.0,22.0 A88,88 0 1 1 71.8,189.3 L89.2,153.2 A48,48 0 1 0 110.0,62.0 Z" fill="#0d9488" stroke="#fff" stroke-width="1.5"><title>会话记录 = 128 GB（57.1%）</title></path><path d="M71.8,189.3 A88,88 0 0 1 41.2,55.1 L72.5,80.1 A48,48 0 0 0 89.2,153.2 Z" fill="#2563eb" stroke="#fff" stroke-width="1.5"><title>审计轨迹 = 64 GB（28.6%）</title></path><path d="M41.2,55.1 A88,88 0 0 1 110.0,22.0 L110.0,62.0 A48,48 0 0 0 72.5,80.1 Z" fill="#d97706" stroke="#fff" stroke-width="1.5"><title>附件 = 32 GB（14.3%）</title></path><text x="110" y="114" text-anchor="middle" class="a2ui-chart-center">224 GB</text></svg>
      </div>
      <ul class="a2ui-chart-legend"><li><span class="a2ui-chart-swatch" style="background:#0d9488"></span><span>会话记录</span><strong>128 GB</strong><em>57.1%</em></li><li><span class="a2ui-chart-swatch" style="background:#2563eb"></span><span>审计轨迹</span><strong>64 GB</strong><em>28.6%</em></li><li><span class="a2ui-chart-swatch" style="background:#d97706"></span><span>附件</span><strong>32 GB</strong><em>14.3%</em></li><li><span class="a2ui-chart-swatch" style="background:#7c3aed"></span><span>冷备</span><strong>0 GB</strong><em>0.0%</em></li></ul>
    </figure>
  </div>"
`;

