# ActWeave AAP base (data plane, not /api/v1)
AAP_BASE_URL=http://127.0.0.1:8082/api/agent-access/v1

# From ActWeave admin: Agent Access Client credentials
AAP_CLIENT_ID=
AAP_CLIENT_SECRET=

# Target agent binding
AAP_WORKSPACE_ID=
AAP_AGENT_ID=

# Space-separated scopes (subset of Grant). Include file:write file:read for attachments.
# Also enable agentAccess.files on the ActWeave server, and RuntimeMultimodal for vision/PDF.
AAP_SCOPES=agent:read conversation:create conversation:read run:create run:read run:cancel event:read interaction:decide file:write file:read

# REQUEST_PASSTHROUGH business outbound (optional but required for tools that call external APIs)
# Connection UUID from 服务连接 (e.g. AI识别管理平台). Agent 能力绑定需关联此 Connection。
OUTBOUND_CONNECTION_ID=
# Optional static business ACCESS_TOKEN for local demo only (prefer UI 「绑定到 BFF」).
# OUTBOUND_ACCESS_TOKEN=
# OUTBOUND_TOKEN_TTL_SECONDS=600
# When true, /bff/chat rejects messages until a business token is bound.
# OUTBOUND_REQUIRE_FOR_CHAT=true

# BFF listen port (Vite proxies /bff → here)
BFF_PORT=8790

# Optional: demo mode without real AAP (set in shell: VITE_DEMO_MODE=mock npm run dev:mock)
# VITE_DEMO_MODE=live
