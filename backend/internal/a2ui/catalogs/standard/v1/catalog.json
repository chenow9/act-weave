{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.actweave.dev/standard/v1/catalog.json",
  "catalogId": "https://catalog.actweave.dev/standard/v1/catalog.json",
  "protocolVersion": "1.0",
  "title": "ActWeave Standard A2UI Catalog v1",
  "description": "Display-only A2UI component catalog. Charts are first-class; component actions are intentionally absent (AAP advertises actions:false).",
  "instructions": "Default to natural language. Attach a surface only when a declarative UI is clearly better than prose.\n\nUse Chart when the user asks about trends, distribution, comparison, composition or ranking over numeric data. Pick chartType by intent: `line`/`area` for change over time, `bar` for comparing categories, `hbar` when category labels are long, `pie`/`donut` for composition of a single whole, `stacked` bar/area for composition across categories.\n\nUse TextField/ChoicePicker/CheckBox/DateTimeInput when collecting several structured fields at once.\n\nNever describe visual styling. Colors, sizes, legends, axes, fonts and spacing are chosen by the client. Provide only semantic data: labels, values, units and the value format.\n\nEvery surface needs exactly one component with id \"root\". Reference children by id; ids must be unique within the surface.",
  "$defs": {
    "ComponentId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "ChildList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/ComponentId" }
    },
    "DataBinding": {
      "type": "object",
      "description": "JSON Pointer into the surface dataModel.",
      "properties": {
        "path": { "type": "string", "pattern": "^/", "maxLength": 256 }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "DynamicString": {
      "oneOf": [
        { "type": "string", "maxLength": 512 },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "DynamicBoolean": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "ChoiceValue": {
      "oneOf": [
        { "type": "string", "maxLength": 512 },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 512 }
        },
        { "$ref": "#/$defs/DataBinding" }
      ]
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["value", "label"],
      "additionalProperties": false
    },
    "ChartPoint": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "value": { "type": "number" }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "ChartSeries": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ChartPoint" }
        }
      },
      "required": ["points"],
      "additionalProperties": false
    },
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/Column" },
        { "$ref": "#/components/Row" },
        { "$ref": "#/components/Card" },
        { "$ref": "#/components/Text" },
        { "$ref": "#/components/Divider" },
        { "$ref": "#/components/Chart" },
        { "$ref": "#/components/TextField" },
        { "$ref": "#/components/CheckBox" },
        { "$ref": "#/components/ChoicePicker" },
        { "$ref": "#/components/DateTimeInput" },
        { "$ref": "#/components/Button" }
      ]
    }
  },
  "components": {
    "Column": {
      "type": "object",
      "description": "Vertical layout container.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Column" },
        "children": { "$ref": "#/$defs/ChildList" },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "spaceBetween", "spaceAround"]
        }
      },
      "required": ["id", "component", "children"],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "description": "Horizontal layout container.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Row" },
        "children": { "$ref": "#/$defs/ChildList" },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "spaceBetween", "spaceAround"]
        }
      },
      "required": ["id", "component", "children"],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "description": "Container with card styling. Holds exactly one child.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Card" },
        "child": { "$ref": "#/$defs/ComponentId" },
        "title": { "$ref": "#/$defs/DynamicString" }
      },
      "required": ["id", "component", "child"],
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "description": "Plain text. Rendered escaped; Markdown is not interpreted in v1.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Text" },
        "text": { "$ref": "#/$defs/DynamicString" },
        "variant": { "type": "string", "enum": ["body", "caption", "heading"] }
      },
      "required": ["id", "component", "text"],
      "additionalProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "Dividing line.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Divider" }
      },
      "required": ["id", "component"],
      "additionalProperties": false
    },
    "Chart": {
      "type": "object",
      "description": "Statistical chart. Semantic data only: the client owns colors, sizes, legends, axes and fonts.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Chart" },
        "chartType": {
          "type": "string",
          "enum": ["bar", "hbar", "line", "area", "pie", "donut"]
        },
        "series": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/ChartSeries" }
            },
            { "$ref": "#/$defs/DataBinding" }
          ]
        },
        "title": { "$ref": "#/$defs/DynamicString" },
        "unit": { "type": "string", "maxLength": 16 },
        "valueFormat": {
          "type": "string",
          "enum": ["plain", "compact", "percent", "currency"]
        },
        "stacked": { "type": "boolean" }
      },
      "required": ["id", "component", "chartType", "series"],
      "additionalProperties": false
    },
    "TextField": {
      "type": "object",
      "description": "Single field for user text input.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "TextField" },
        "label": { "$ref": "#/$defs/DynamicString" },
        "value": { "$ref": "#/$defs/DynamicString" },
        "placeholder": { "$ref": "#/$defs/DynamicString" },
        "variant": {
          "type": "string",
          "enum": ["shortText", "longText", "number", "email", "tel", "date", "password"]
        },
        "required": { "type": "boolean" }
      },
      "required": ["id", "component", "label"],
      "additionalProperties": false
    },
    "CheckBox": {
      "type": "object",
      "description": "Checkbox with a label and a boolean value.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "CheckBox" },
        "label": { "$ref": "#/$defs/DynamicString" },
        "value": { "$ref": "#/$defs/DynamicBoolean" }
      },
      "required": ["id", "component", "label"],
      "additionalProperties": false
    },
    "ChoicePicker": {
      "type": "object",
      "description": "Select one or more options.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "ChoicePicker" },
        "label": { "$ref": "#/$defs/DynamicString" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ChoiceOption" }
        },
        "value": { "$ref": "#/$defs/ChoiceValue" },
        "multiple": { "type": "boolean" }
      },
      "required": ["id", "component", "label", "options"],
      "additionalProperties": false
    },
    "DateTimeInput": {
      "type": "object",
      "description": "Date and/or time input.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "DateTimeInput" },
        "label": { "$ref": "#/$defs/DynamicString" },
        "value": { "$ref": "#/$defs/DynamicString" },
        "mode": { "type": "string", "enum": ["date", "time", "datetime"] }
      },
      "required": ["id", "component", "label"],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "description": "Button. Display-only in v1: no action property exists, so a surface cannot request a callback.",
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": { "const": "Button" },
        "label": { "$ref": "#/$defs/DynamicString" },
        "variant": { "type": "string", "enum": ["primary", "borderless"] }
      },
      "required": ["id", "component", "label"],
      "additionalProperties": false
    }
  }
}
