{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actweave.dev/aap/v1/event-envelope.schema.json",
  "title": "AAP v1 Protocol Event Envelope",
  "x-actweave-protocol-version": "2026-08-11",
  "x-actweave-forbidden-property-names": ["authorization", "cookie", "password", "secret", "token", "resumetoken", "signedurl", "chainofthought"],
  "type": "object",
  "required": ["specVersion", "type", "eventId", "streamId", "sequence", "occurredAt", "workspaceId", "agentId", "conversationId", "runId", "traceId", "data"],
  "properties": {
    "specVersion": {"const": "1.0"},
    "type": {"type": "string", "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$"},
    "eventId": {"$ref": "common.schema.json#/$defs/uuid"},
    "streamId": {"type": "string", "pattern": "^run:[0-9a-fA-F-]{36}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "occurredAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "workspaceId": {"$ref": "common.schema.json#/$defs/uuid"},
    "agentId": {"$ref": "common.schema.json#/$defs/uuid"},
    "conversationId": {"$ref": "common.schema.json#/$defs/uuid"},
    "runId": {"$ref": "common.schema.json#/$defs/uuid"},
    "traceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "data": {"type": "object"}
  },
  "additionalProperties": true
}
