{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actweave.dev/aap/v1/content-part.schema.json",
  "title": "AAP v1 Content Part",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "maxLength": 1048576}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "fileId"],
      "properties": {
        "type": {"const": "input_file"},
        "fileId": {"$ref": "common.schema.json#/$defs/uuid"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 255}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "surface"],
      "properties": {
        "type": {"const": "a2ui"},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "surface": {
          "type": "object",
          "description": "Declarative A2UI surface (opaque beyond size/type; sensitive-key scan exempt — KD-11)"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "not": {"enum": ["text", "input_file", "a2ui"]}}
      },
      "additionalProperties": true
    }
  ]
}
