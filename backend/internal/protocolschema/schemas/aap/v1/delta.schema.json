{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.actweave.dev/aap/v1/delta.schema.json",
  "title": "AAP v1 Item Delta",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "index", "text"],
      "properties": {
        "type": {"const": "text_delta"},
        "index": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "partialJson"],
      "properties": {
        "type": {"const": "arguments_json_delta"},
        "partialJson": {"type": "string"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "output_delta"},
        "text": {"type": "string"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "current", "unit"],
      "properties": {
        "type": {"const": "progress"},
        "current": {"type": "number", "minimum": 0},
        "total": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "message": {"type": "string", "maxLength": 1024}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "not": {"enum": ["text_delta", "arguments_json_delta", "output_delta", "progress"]}}
      },
      "additionalProperties": true
    }
  ]
}
